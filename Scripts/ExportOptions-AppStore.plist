<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <!-- Leave the .pkg on disk rather than shipping it straight to Apple, so
         it can be inspected and validated first. Uploading is always an
         explicit `appstore-release.sh --upload`. -->
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>Q34D9AYJ95</string>
    <key>signingStyle</key>
    <string>automatic</string>
</dict>
</plist>
