# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Writ.xcodeproj is generated from project.yml by XcodeGen, and is committed
# anyway. Xcode Cloud refuses a repository whose project is not at the root —
# "Project Writ.xcodeproj does not exist at the root of the repository",
# exit 66 — and it checks that BEFORE running ci_scripts/ci_post_clone.sh, so
# the hook cannot stand in for the file. The committed copy exists only to
# satisfy that check, and its contents are never read: every build path
# (make-release.sh, appstore-release.sh, ci_post_clone.sh, CI) runs
# `xcodegen generate` first, so a stale committed copy cannot reach a build
# the way it did in Gridka (f8e3203). Do not try to enforce that the
# committed bytes match a fresh generate — objectVersion is derived from the
# installed Xcode, so they differ between machines on different versions.
#
# project.yml remains the only source of truth. Do not edit the project in
# Xcode: General-tab changes are discarded by the next `xcodegen generate`,
# and they are discarded silently.
*.xcworkspace/

# Three things inside the generated project are tracked, and the rules below
# are verbose because git cannot re-include a file whose parent directory is
# excluded — every level down to each one has to be opened explicitly.
Writ.xcodeproj/*
!Writ.xcodeproj/project.pbxproj
!Writ.xcodeproj/xcshareddata
Writ.xcodeproj/xcshareddata/*
!Writ.xcodeproj/xcshareddata/xcschemes
# Xcode Cloud disables automatic dependency resolution, so it requires a
# checked-in resolved file and fails the build without one:
#   "a resolved file is required when automatic dependency resolution is
#    disabled and should be placed at .../xcshareddata/swiftpm/Package.resolved"
# This is the one file here whose *contents* matter — it pins swift-markdown
# and swift-cmark. After changing a package dependency, resolve in Xcode and
# commit the updated file, or cloud builds resolve against stale revisions.
# `xcodegen generate` preserves it (verified), so the post-clone hook does not
# destroy it. Note this re-opens a path that `*.xcworkspace/` above excludes,
# which is why that rule comes first.
!Writ.xcodeproj/project.xcworkspace
Writ.xcodeproj/project.xcworkspace/*
!Writ.xcodeproj/project.xcworkspace/xcshareddata
Writ.xcodeproj/project.xcworkspace/xcshareddata/*
!Writ.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
Writ.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Writ.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
# The local packages' own resolved files stay out: the Xcode build resolves
# through the workspace file above, which is the authoritative one.
Package.resolved
!Writ.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods / Carthage (unused but defensive)
Pods/
Carthage/Build/

# Benchmark fixtures (regenerable via `swift run writ-fixtures Benchmarks/Fixtures`)
Benchmarks/Fixtures/

# Benchmark output
Benchmarks/Results/
*.json.bench

